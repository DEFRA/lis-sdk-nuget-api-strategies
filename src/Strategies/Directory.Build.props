<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!--
    Suppressions for the existing public API, which consuming services depend on:
    - CA1720: RestSerializer and SoapSerializer take a parameter named 'object'; renaming it would break named-argument callers.
    - RS0026: the When overloads already ship with optional parameters.
    - CS1591: public members are not yet XML-documented.
  -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);CA1720;RS0026;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Defra.Livestock.Sdk.Api.Strategies.Abstractions" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Polly.Core" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Defra.Livestock.Sdk.Api.Strategies.Tests" />
  </ItemGroup>
</Project>
